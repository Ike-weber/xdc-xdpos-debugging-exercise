# Default network target for join.sh (override with --ip / --bootnodes / --genesis).
#
# This points at XDC devnet 5151 (cross-client mainnet-parity devnet). With these
# defaults, a plain `./join.sh` (or `./join.sh --client geth|erigon`) syncs 5151
# with no extra flags.
DEFAULT_HOST=65.21.71.4
DEFAULT_BOOTNODE_PORT=30551

# Genesis used when --genesis is not passed.
DEFAULT_GENESIS=genesis/genesis-5151.json

# The 5151 masternode enodes are on four separate hosts (no single-host bootnode),
# so dial them directly. join.sh uses DEFAULT_BOOTNODES verbatim when no
# --bootnodes/--ip is given, instead of deriving one from bootnode.key.
DEFAULT_BOOTNODES="enode://483e6b8858755e1c58578122a2e20ada7a3b0e49bee0f0141649e77184684d909a7b1535a11c4eb7e902faf6fe9509836d1bfb8a18adfdd4e4b8160e47a84024@65.21.71.4:30551,enode://a496cf12733f3a7bb2a498109c119bf98f49b46812ea6412a7367d6835d78240530804efde54ed471cb9950637b552f53419e3a0d4b247f19565e687942ec3f1@65.21.27.213:30551,enode://918dcb8137f06fe3a28da977a77b099ab41fe8198d6e5804c7dbd082913b4e3b8cc55e42a69ac5647a61eb54b69ad8a8be564e5c0f941d1f4fd364e52e67aaa4@95.217.112.125:30551,enode://3d53b9989b3ae8e5e9bbd9ac94e382590419f72aa557882dc6e1c85f766317daca57447958d434fca434093da8ca58cbb794b6b46839118eaaf5076c2e944077@135.181.117.109:30551"

# Optional machine label used as the <host> token in the node identity / ethstats
# name (join.sh: <client>-v<ver>-<MACHINE>-<nodetype>). Unset -> the auto-detected
# hostname is used. Set this to give a host a stable, readable dashboard name.
#MACHINE=frankfurt-1

# Skynet dashboard base URL. run.sh appends "?net=<chainId>" and prints the
# result on bring-up, so the link always points at the network you just started
# rather than a hardcoded one. Override to point at a different dashboard.
SKYNET_BASE_URL=https://skynet.xdcindia.com/stats
