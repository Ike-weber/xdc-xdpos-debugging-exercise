# Sample config for publish-bins.sh -- copy this to ./publish.env (repo root)
# and fill in at least PUBLISH_DIR before running anything other than
# --build-only / --dry-run. publish.env itself is gitignored (mirrors the
# repo's .env / network.env pattern): it holds where your binaries actually
# get published, which is host-specific and not something to commit.
#
# publish-bins.sh sources this file if it exists, then falls back to the
# defaults documented below for anything left unset here.

# SSH target that serves https://xdc.network/snapshots/bin/ (PUBLISH_BASE_URL
# below). Default matches the existing snapshot host.
PUBLISH_HOST=95.217.56.168
PUBLISH_PORT=12141
PUBLISH_USER=root

# REQUIRED, no default: the remote directory that IS the web root serving
# PUBLISH_BASE_URL (e.g. /var/www/snapshots/bin on the host above). Every
# publish (non---build-only) run hard-aborts before any side effect if this
# is unset -- guessing this path wrong risks writing files nobody serves.
PUBLISH_DIR=

# Path to a private key for key-based SSH auth (ssh -i). publish-bins.sh is
# key-based ONLY -- it never prompts for or handles a password. Leave unset
# to use ssh-agent / your default identity; override per-run with --ssh-key.
#PUBLISH_SSH_KEY=/path/to/id_ed25519

# The public base URL these binaries are served from (used to build the
# download URL for --verify-public). Only change this if xdc.network's
# snapshot layout ever moves.
PUBLISH_BASE_URL=https://xdc.network/snapshots/bin/
